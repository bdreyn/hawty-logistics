---
layout: base.njk
---
<section class="coming-soon">
  <div class="coming-soon-inner">
    <img src="{{ site.logo }}" alt="{{ site.companyName }} logo" class="coming-soon-logo" onerror="this.style.display='none'">
    <h1>{{ site.companyName }}</h1>
    <p class="tagline">{{ site.tagline }}</p>
    <p class="notice">Our full site is coming soon.</p>
    {% if site.email or site.phone %}
    <p class="contact-line">
      {% if site.email %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}
      {% if site.email and site.phone %} &middot; {% endif %}
      {% if site.phone %}{{ site.phone }}{% endif %}
    </p>
    {% endif %}
  </div>
</section>
