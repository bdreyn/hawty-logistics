<header class="navbar">
  <div class="navbar-inner">
    <a href="/" class="navbar-brand">
      {% if site.logo %}
      <img src="{{ site.logo }}" alt="{{ site.companyName }} logo" class="navbar-logo" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('sr-only');">
      <span class="navbar-name sr-only">{{ site.companyName }}</span>
      {% else %}
      <span class="navbar-name">{{ site.companyName }}</span>
      {% endif %}
    </a>
    <nav class="navbar-links">
      {% for section in homepage.sections %}
        {% if section.visible and section.type != "hero" %}
        <a href="/#{{ section.type }}">{{ section.heading }}</a>
        {% endif %}
      {% endfor %}
    </nav>
  </div>
</header>
