<section id="services" class="bg-gray-50 py-16 sm:py-24">
  <div class="container-page">
    <h2 class="section-heading">{{ section.heading }}</h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {% for service in collections.services %}
      <div class="rounded-lg bg-white p-6 shadow-sm">
        {% if service.data.icon %}
        <img src="{{ service.data.icon }}" alt="" class="mb-4 h-10 w-10">
        {% endif %}
        <h3 class="text-xl font-semibold text-gray-900">{{ service.data.title }}</h3>
        <p class="mt-2 text-gray-600">{{ service.data.summary }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
