<section id="hero" class="bg-brand-light">
  <div class="container-page py-20 text-center sm:py-28">
    <h1 class="text-4xl font-bold text-gray-900 sm:text-5xl">{{ section.heading }}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-700">{{ section.body }}</p>
    {% if section.ctaText %}
    <a href="{{ section.ctaLink }}" class="btn-primary mt-8">{{ section.ctaText }}</a>
    {% endif %}
  </div>
</section>
