<section id="testimonials" class="container-page py-16 sm:py-24">
  <h2 class="section-heading">{{ section.heading }}</h2>
  <div class="grid gap-8 sm:grid-cols-2">
    {% for testimonial in collections.testimonials %}
    <blockquote class="rounded-lg border border-gray-200 p-6">
      <div class="text-lg italic text-gray-700">{{ testimonial.templateContent | safe }}</div>
      <footer class="mt-4 flex items-center gap-3">
        {% if testimonial.data.photo %}
        <img src="{{ testimonial.data.photo }}" alt="" class="h-10 w-10 rounded-full object-cover">
        {% endif %}
        <div>
          <p class="font-semibold text-gray-900">{{ testimonial.data.name }}</p>
          <p class="text-sm text-gray-500">{{ testimonial.data.company }}</p>
        </div>
      </footer>
    </blockquote>
    {% endfor %}
  </div>
</section>
