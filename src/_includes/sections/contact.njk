<section id="contact" class="bg-brand-light py-16 sm:py-24">
  <div class="container-page grid gap-12 lg:grid-cols-2">
    <div>
      <h2 class="section-heading">{{ section.heading }}</h2>
      <p class="text-gray-700">Request a shipping quote or reach out with a general question — we'll get back to you shortly.</p>
      <dl class="mt-6 space-y-2 text-gray-700">
        <div><dt class="inline font-semibold">Phone:</dt> <dd class="inline">{{ site.phone }}</dd></div>
        <div><dt class="inline font-semibold">Email:</dt> <dd class="inline">{{ site.email }}</dd></div>
        <div><dt class="inline font-semibold">Address:</dt> <dd class="inline">{{ site.address }}</dd></div>
      </dl>
    </div>

    <form id="quote-form" class="space-y-4 rounded-lg bg-white p-6 shadow-sm">
      <div class="absolute left-[-9999px]" aria-hidden="true">
        <label for="website">Leave this field blank</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
      </div>
      <fieldset>
        <legend class="block text-sm font-medium text-gray-700">What can we help with?</legend>
        <div class="mt-2 flex gap-6">
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <input type="radio" name="requestType" value="quote" checked class="border-gray-300 text-brand focus:ring-brand">
            Get a Quote
          </label>
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <input type="radio" name="requestType" value="general" class="border-gray-300 text-brand focus:ring-brand">
            General Inquiry
          </label>
        </div>
      </fieldset>
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700">Name</label>
        <input type="text" id="name" name="name" required class="mt-1 w-full rounded-md border-gray-300 shadow-sm focus:border-brand focus:ring-brand">
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
        <input type="email" id="email" name="email" required class="mt-1 w-full rounded-md border-gray-300 shadow-sm focus:border-brand focus:ring-brand">
      </div>
      <div>
        <label for="phone" class="block text-sm font-medium text-gray-700">Phone</label>
        <input type="tel" id="phone" name="phone" class="mt-1 w-full rounded-md border-gray-300 shadow-sm focus:border-brand focus:ring-brand">
      </div>
      <div id="quote-fields" class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="origin" class="block text-sm font-medium text-gray-700">Origin</label>
            <input type="text" id="origin" name="origin" class="mt-1 w-full rounded-md border-gray-300 shadow-sm focus:border-brand focus:ring-brand">
          </div>
          <div>
            <label for="destination" class="block text-sm font-medium text-gray-700">Destination</label>
            <input type="text" id="destination" name="destination" class="mt-1 w-full rounded-md border-gray-300 shadow-sm focus:border-brand focus:ring-brand">
          </div>
        </div>
        <div>
          <label for="cargo" class="block text-sm font-medium text-gray-700">Cargo Details</label>
          <input type="text" id="cargo" name="cargo" placeholder="Weight, dimensions, freight class, etc." class="mt-1 w-full rounded-md border-gray-300 shadow-sm focus:border-brand focus:ring-brand">
        </div>
      </div>
      <div>
        <label for="message" id="message-label" class="block text-sm font-medium text-gray-700">Message</label>
        <textarea id="message" name="message" rows="4" class="mt-1 w-full rounded-md border-gray-300 shadow-sm focus:border-brand focus:ring-brand"></textarea>
      </div>
      <button type="submit" class="btn-primary w-full">Submit Request</button>
      <p id="quote-form-status" class="text-sm" role="status"></p>
    </form>
  </div>
</section>

<script src="{{ '/assets/js/quote-form.js' | url }}"></script>
